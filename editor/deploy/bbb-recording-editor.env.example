BBB_EDITOR_PORT=8099
BBB_EDITOR_RAW_ROOT=/var/bigbluebutton/recording/raw
BBB_EDITOR_STATE_ROOT=/var/lib/bbb-recording-editor
BBB_EDITOR_PUBLISHED_ROOT=/var/bigbluebutton/published/presentation
BBB_EDITOR_BUILD_ROOT=/opt/bbb-recording-editor/build-editor
# Auth is enforced by the Nginx location below. For direct access or an extra
# backend check, set BOTH values (use a root-readable EnvironmentFile).
# BBB_EDITOR_USERNAME=admin
# BBB_EDITOR_PASSWORD=replace-with-a-long-password
