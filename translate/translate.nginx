# Caption translation for the presentation player. Only the two endpoints
# the player uses are exposed, on the same origin as the recordings. They go
# through the gateway (gateway.py, port 5050), which holds each viewer to one
# language at a time while it gets ready, as the player does, and limits the
# requests a viewer or address runs at once
location = /playback/translate/languages {
  proxy_pass http://127.0.0.1:5050/languages;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location = /playback/translate/translate {
  limit_except POST { deny all; }
  proxy_pass http://127.0.0.1:5050/translate;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_read_timeout 130s;
  client_max_body_size 256k;
}
